# Optional. Without it the dashboard still shows advice, generated from the
# fixed PAGASA rules in lib/advisories.ts rather than by a model.
#
# Get one from https://aistudio.google.com/apikey. This is the API free tier,
# which is separate from a Gemini Advanced or Google One AI subscription.
#
# Copy this file to .env.local, which is gitignored, and put the key there.
GEMINI_API_KEY=
